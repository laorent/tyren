# Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Web Access Password (Required)
WEB_ACCESS_PASSWORD=your_secure_password_here

# Auth token lifetime in hours (Optional, defaults to 24)
AUTH_TOKEN_TTL_HOURS=24

# Gemini Model Name for regular chat (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Model used for "Thinking Mode" (Optional, defaults to gemini-3.7-flash)
GEMINI_THINKING_MODEL=gemini-3.7-flash

# Thinking Mode level for Gemini 3.7 Flash: low, medium, or high (defaults to high)
GEMINI_THINKING_LEVEL=high
